{
 "duration": 51.425,
 "voice": "hm_omega",
 "speed": 1.1,
 "lines": [
  {
   "i": 0,
   "text": "\u0917\u0902\u0917\u093e \u0924\u094b \u0938\u094d\u0935\u0930\u094d\u0917 \u092e\u0947\u0902 \u092c\u0939\u0924\u0940 \u0925\u0940\u0902,",
   "start": 0.4,
   "end": 2.25
  },
  {
   "i": 1,
   "text": "\u092b\u093f\u0930 \u0927\u0930\u0924\u0940 \u092a\u0930 \u0906\u0908\u0902 \u0915\u0948\u0938\u0947?",
   "start": 2.56,
   "end": 4.202
  },
  {
   "i": 2,
   "text": "\u0930\u093e\u091c\u093e \u0938\u0917\u0930 \u0915\u0947 \u0938\u093e\u0920 \u0939\u091c\u093c\u093e\u0930 \u092c\u0947\u091f\u0947,",
   "start": 4.552,
   "end": 6.632
  },
  {
   "i": 3,
   "text": "\u090f\u0915 \u0916\u094b\u092f\u093e \u0939\u0941\u0906 \u0918\u094b\u0921\u093c\u093e \u0922\u0942\u0901\u0922\u0924\u0947 \u0939\u0941\u090f,",
   "start": 6.972,
   "end": 8.962
  },
  {
   "i": 4,
   "text": "\u0915\u092a\u093f\u0932 \u092e\u0941\u0928\u093f \u0915\u0947 \u0906\u0936\u094d\u0930\u092e \u092a\u0939\u0941\u0901\u091a\u0947,",
   "start": 9.312,
   "end": 10.962
  },
  {
   "i": 5,
   "text": "\u0914\u0930 \u092e\u0941\u0928\u093f \u0915\u0940 \u0906\u0901\u0916\u0947\u0902 \u0916\u0941\u0932\u0924\u0947 \u0939\u0940,",
   "start": 11.342,
   "end": 12.982
  },
  {
   "i": 6,
   "text": "\u0938\u092c \u0930\u093e\u0916 \u0939\u094b \u0917\u090f.",
   "start": 13.322,
   "end": 14.255
  },
  {
   "i": 7,
   "text": "\u0909\u0928\u094d\u0939\u0947\u0902 \u092e\u0941\u0915\u094d\u0924\u093f \u0938\u093f\u0930\u094d\u092b\u093c \u0917\u0902\u0917\u093e \u0915\u093e \u091c\u0932 \u0926\u093f\u0932\u093e \u0938\u0915\u0924\u093e \u0925\u093e.",
   "start": 14.605,
   "end": 17.818
  },
  {
   "i": 8,
   "text": "\u092a\u0940\u0922\u093c\u093f\u092f\u093e\u0901 \u092c\u0940\u0924 \u0917\u0908\u0902,",
   "start": 18.118,
   "end": 19.208
  },
  {
   "i": 9,
   "text": "\u092b\u093f\u0930 \u0930\u093e\u091c\u093e \u092d\u0917\u0940\u0930\u0925 \u0928\u0947,",
   "start": 19.488,
   "end": 20.838
  },
  {
   "i": 10,
   "text": "\u092c\u0930\u0938\u094b\u0902 \u0924\u0915 \u0915\u0920\u094b\u0930 \u0924\u092a \u0915\u093f\u092f\u093e.",
   "start": 21.128,
   "end": 22.709
  },
  {
   "i": 11,
   "text": "\u0917\u0902\u0917\u093e \u092e\u093e\u0928 \u0917\u0908\u0902,",
   "start": 23.009,
   "end": 24.169
  },
  {
   "i": 12,
   "text": "\u092a\u0930 \u0909\u0928\u0915\u093e \u0935\u0947\u0917 \u0907\u0924\u0928\u093e \u0924\u0947\u091c\u093c \u0925\u093e,",
   "start": 24.439,
   "end": 26.139
  },
  {
   "i": 13,
   "text": "\u0915\u093f \u0927\u0930\u0924\u0940 \u0939\u0940 \u091f\u0942\u091f \u091c\u093e\u0924\u0940.",
   "start": 26.469,
   "end": 27.818
  },
  {
   "i": 14,
   "text": "\u0924\u092c \u0936\u093f\u0935 \u0928\u0947,",
   "start": 28.118,
   "end": 28.828
  },
  {
   "i": 15,
   "text": "\u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u092a\u0928\u0940 \u091c\u091f\u093e\u0913\u0902 \u092e\u0947\u0902 \u0925\u093e\u092e \u0932\u093f\u092f\u093e,",
   "start": 29.158,
   "end": 31.038
  },
  {
   "i": 16,
   "text": "\u0914\u0930 \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0927\u0930\u0924\u0940 \u092a\u0930 \u091b\u094b\u0921\u093c\u093e.",
   "start": 31.368,
   "end": 33.25
  },
  {
   "i": 17,
   "text": "\u092d\u0917\u0940\u0930\u0925 \u0906\u0917\u0947-\u0906\u0917\u0947 \u091a\u0932\u0947, \u0917\u0902\u0917\u093e \u092a\u0940\u091b\u0947-\u092a\u0940\u091b\u0947,",
   "start": 33.55,
   "end": 36.73
  },
  {
   "i": 18,
   "text": "\u0939\u093f\u092e\u093e\u0932\u092f \u0938\u0947 \u0938\u093e\u0917\u0930 \u0924\u0915.",
   "start": 37.03,
   "end": 38.235
  },
  {
   "i": 19,
   "text": "\u0914\u0930 \u091c\u0939\u093e\u0901 \u0930\u093e\u0916 \u092a\u0921\u093c\u0940 \u0925\u0940,",
   "start": 38.535,
   "end": 39.895
  },
  {
   "i": 20,
   "text": "\u0935\u0939\u093e\u0901 \u0906\u091c \u0939\u0948 \u0917\u0902\u0917\u093e\u0938\u093e\u0917\u0930.",
   "start": 40.195,
   "end": 41.868
  },
  {
   "i": 21,
   "text": "\u0907\u0938\u0940\u0932\u093f\u090f \u0917\u0902\u0917\u093e \u0915\u093e \u090f\u0915 \u0928\u093e\u092e \u0939\u0948,",
   "start": 42.168,
   "end": 44.018
  },
  {
   "i": 22,
   "text": "\u092d\u093e\u0917\u0940\u0930\u0925\u0940.",
   "start": 44.258,
   "end": 44.984
  },
  {
   "i": 23,
   "text": "\u0910\u0938\u0940 \u0939\u0940 \u0905\u0928\u0915\u0939\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f,",
   "start": 45.484,
   "end": 47.464
  },
  {
   "i": 24,
   "text": "\u092b\u093c\u0949\u0932\u094b \u0915\u0930\u0947\u0902, \u0905\u0928\u091f\u094b\u0932\u094d\u0921 \u0938\u094d\u091f\u094b\u0930\u0940\u091c\u093c.",
   "start": 47.804,
   "end": 49.725
  }
 ]
}